# Servidor y Base de Datos
PORT=4006
FRONTEND_URL=http://localhost:3006
DATABASE_URL="file:./dev.db"

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-largo-para-desarrollo-local
JWT_EXPIRES_IN=7d

# Admin Seed Inicial
ADMIN_EMAIL=admin@invitaciones.local
ADMIN_PASSWORD=admin123

# Gmail SMTP (usar Contrasena de Aplicacion de Google)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="Invitaciones de Boda"

# WhatsApp Baileys
WHATSAPP_SESSION_DIR=./sessions/wa
WHATSAPP_MIN_DELAY_MS=2500
WHATSAPP_MAX_DELAY_MS=5500

# Google Drive OAuth2 (Cuenta Gmail Personal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4006/api/media/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Limite de subida (MB)
MAX_UPLOAD_MB=150
TEMP_UPLOAD_DIR=./uploads/tmp
